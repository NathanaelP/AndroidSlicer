# Pinned sources for the MobileSlicer engine build (milestone M0).
# Every dependency is fetched at an exact tag or commit so builds are reproducible.
# Versions follow what CuraEngine 5.13.0's own Conan recipe asks for.

CURAENGINE_REPO=https://github.com/Ultimaker/CuraEngine
CURAENGINE_REF=5.13.0

# Cura frontend, for its setting definitions only (fdmprinter/fdmextruder.def.json, LGPL-3.0).
CURA_REPO=https://github.com/Ultimaker/Cura
CURA_REF=5.13.0

# Ultimaker's Conan recipe index; only its StandardProjectSettings.cmake is used.
ULTIMAKER_INDEX_REPO=https://github.com/Ultimaker/conan-ultimaker-index
ULTIMAKER_INDEX_REF=c4077fc3e719b436d1cdc2032bf3f851b6f089bb

SCRIPTA_REPO=https://github.com/Ultimaker/Scripta_public
SCRIPTA_REF=b96045cd9b531d97f42dec8c9a0ef52f773f6b90

FMT_REPO=https://github.com/fmtlib/fmt
FMT_REF=11.1.3

SPDLOG_REPO=https://github.com/gabime/spdlog
SPDLOG_REF=v1.15.1

RANGEV3_REPO=https://github.com/ericniebler/range-v3
RANGEV3_REF=0.12.0

# Conan "rapidjson/cci.20230929"
RAPIDJSON_REPO=https://github.com/Tencent/rapidjson
RAPIDJSON_REF=f9d53419e912910fd8fa57d5705fa41425428c35

